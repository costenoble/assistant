# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role : serveur uniquement (cron, ingestion). Ne JAMAIS l'exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Accès ──────────────────────────────────────────────────
# Seul cet email peut se connecter (app mono-utilisateur).
OWNER_EMAIL=ryan.costenoble@cstlab.dev
# UUID de ton utilisateur dans auth.users (visible dans Supabase > Authentication après ta 1re connexion).
OWNER_USER_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron ───────────────────────────────────────────────────
# Secret partagé avec Vercel Cron / Supabase pg_cron (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=change-me-long-random-string

# ─── Mails Hostinger (IMAP) ─────────────────────────────────
# Tableau JSON : tu peux brancher plusieurs boîtes.
MAIL_ACCOUNTS=[{"id":"cstlab","label":"cstlab.dev","host":"imap.hostinger.com","port":993,"user":"contact@cstlab.dev","password":"..."}]
# Profondeur de la 1re synchro (jours).
MAIL_INITIAL_SYNC_DAYS=14

# ─── Microsoft 365 (Semaphors) ──────────────────────────────
# App enregistrée dans Entra ID (Azure AD). Voir README > Microsoft 365.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "organizations", "common" ou l'ID du tenant Semaphors.
MS_TENANT_ID=organizations
