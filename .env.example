# ─── Base de données (Neon) ─────────────────────────────────
# Ajoutées automatiquement par l'intégration Neon de Vercel (Storage > Create Database > Neon),
# puis récupérées en local avec `vercel env pull`.
# DATABASE_URL = connexion « pooled » ; DATABASE_URL_UNPOOLED = connexion directe (migrations).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ─── Accès ──────────────────────────────────────────────────
# Seule cette adresse est admin. Les clients se connectent via leur fiche contact (accès portail).
OWNER_EMAIL=ryan.costenoble@cstlab.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signe les sessions : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32

# ─── Emails de connexion (SMTP Hostinger) ───────────────────
# Sans SMTP, en développement, le lien de connexion s'affiche dans le terminal.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@cstlab.dev
SMTP_PASS=
# Expéditeur affiché (optionnel) : "Cockpit <contact@cstlab.dev>"
MAIL_FROM=

# ─── Cron ───────────────────────────────────────────────────
# Vercel Cron envoie automatiquement « Authorization: Bearer <CRON_SECRET> ». openssl rand -hex 32
CRON_SECRET=change-me-long-random-string

# ─── Mails Hostinger (IMAP) ─────────────────────────────────
# Tableau JSON : tu peux brancher plusieurs boîtes.
MAIL_ACCOUNTS=[{"id":"cstlab","label":"cstlab.dev","host":"imap.hostinger.com","port":993,"user":"contact@cstlab.dev","password":"..."}]
# Profondeur de la 1re synchro (jours).
MAIL_INITIAL_SYNC_DAYS=14

# ─── Microsoft 365 (Semaphors) ──────────────────────────────
# App enregistrée dans Entra ID (Azure AD). Voir README > Microsoft 365.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "organizations", "common" ou l'ID du tenant Semaphors.
MS_TENANT_ID=organizations
